{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Genius Installer Manager",
  "version": "0.2.0",
  "identifier": "com.itgenius.pr-extension-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Genius Installer Manager",
        "width": 440,
        "height": 620,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "itGenius",
    "shortDescription": "Install and update itGenius extensions for Adobe Premiere Pro",
    "longDescription": "Installs, updates and uninstalls itGenius extensions for Adobe Premiere Pro, and checks each extension's GitHub repo for new releases.",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/georg-itgclaudeAgent/genius-installer-manager/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwM0I5RTM5MzNDQ0REMkQKUldRdDNjd3pPWjQ3c09vVUJQcUtlb2NaODJvMEh4MWpMOEZUYWllN0YyU0psRm55dzVmcjdZUG4K"
    }
  }
}
